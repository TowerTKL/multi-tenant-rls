{
  "name": "multi-tenant-rls",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant Postgres with row-level security, wired into Drizzle ORM through a single withTenant() helper.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "demo": "tsx --env-file-if-exists=.env src/scripts/demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
